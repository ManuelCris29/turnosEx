# Normalizar saltos de línea
* text=auto

# Python siempre en LF (estándar)
*.py text eol=lf

# HTML y plantillas en LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Archivos de configuración en LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Contenedores y scripts de shell SIEMPRE en LF
# (un Dockerfile/script con CRLF rompe el shell del contenedor).
Dockerfile text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
*.sh text eol=lf
