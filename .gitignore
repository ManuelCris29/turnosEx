# ── Basura personal en la RAÍZ del repo (screenshots, notas, borradores) ──
# Solo afecta a la raíz (por el "/"); no toca archivos en subcarpetas como
# docs/, instructivos/ ni AppTurnosExplora/. requirements.txt se conserva.
/*.png
/*.jpg
/*.jpeg
/*.svg
/*.txt
/*.docx
!/requirements.txt
/refactorizacionpendi/
*check_files.sh

# Respaldos locales previos a cambios grandes (no versionar)
_backups/

# Logs de aplicacion (rotativos). Nunca se versionan: contienen datos personales.
AppTurnosExplora/logs/

# Estaticos recolectados por collectstatic (copia generada, la sirve WhiteNoise/Nginx).
# Nunca se versiona: se regenera en cada despliegue y son cientos de archivos.
AppTurnosExplora/staticfiles/

# Material de negocio (docx/mwb/sql): solo local, no se versiona.
instructivos/
