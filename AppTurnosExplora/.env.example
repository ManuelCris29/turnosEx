# Plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales

ENVIRONMENT=development  # development | production

SECRET_KEY=cambia-esto-por-una-clave-segura-generada

DEBUG=True  # False en producción

ALLOWED_HOSTS=127.0.0.1,localhost  # En prod: tu-dominio.com

# Base de datos MySQL
DB_NAME=bdturnosex
DB_USER=root
DB_PASSWORD=tu-contraseña-aqui
DB_HOST=localhost
DB_PORT=3306

# Segundos que se reutiliza una conexión a la base (0 = abrir y cerrar en cada
# petición). Por defecto: 0 en desarrollo, 60 en producción. No suele tocarse.
# DB_CONN_MAX_AGE=60

# TLS hacia la base. Vacío = sin cifrado (desarrollo, base local).
# En producción, ruta al bundle de CA de Amazon que la imagen ya incluye:
#   DB_SSL_CA=/app/certs/rds-ca-global.pem
DB_SSL_CA=

# Email SMTP
# En producción (AWS) esto apunta al endpoint SMTP de Amazon SES:
#   EMAIL_HOST=email-smtp.<region>.amazonaws.com
#   EMAIL_HOST_USER / EMAIL_HOST_PASSWORD = credenciales SMTP de SES,
#   que NO son una access key de IAM. Ver docs/05-referencia/deployment/
#   MANUAL_RECUPERAR_CONTRASENA.md
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@dominio.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
DEFAULT_FROM_EMAIL=tu-email@dominio.com

# Para probar el flujo de "olvidé mi contraseña" sin SMTP, los correos se
# imprimen por consola con:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Vida del enlace de recuperación de contraseña, en segundos.
# El valor por defecto de DJANGO son 3 días; aquí son 30 minutos a propósito:
# ese enlace es una llave de la cuenta viajando por correo.
PASSWORD_RESET_TIMEOUT=1800

# URL del sitio (sin slash final)
SITE_URL=http://127.0.0.1:8000  # En prod: https://tu-dominio.com

# Días que siguen sirviendo los enlaces de aprobar/rechazar del correo. Esos
# enlaces actúan sin iniciar sesión, así que caducan. Van firmados con SECRET_KEY:
# en AWS todas las instancias deben compartir la MISMA SECRET_KEY, y rotarla
# invalida los enlaces ya enviados.
APPROVAL_LINK_MAX_AGE_DAYS=30

# CORS - dominios que pueden consumir la app (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Caché. Vacío o sin definir = LocMemCache, válido SOLO en desarrollo (1 proceso).
# En producción es OBLIGATORIA una caché compartida: Gunicorn corre varios workers
# y con LocMemCache cada uno tendría la suya, así que invalidar Mis Turnos limpiaría
# solo uno y los demás servirían datos viejos hasta una hora.
#   redis://mi-cluster.cache.amazonaws.com:6379/1   (ElastiCache; rediss:// si usa TLS)
#   db://cache_appturnos                            (tabla en RDS; requiere una vez:
#                                                    python manage.py createcachetable)
CACHE_URL=

# ---------------------------------------------------------------------------
# django-axes: cuántos intermediarios hay DELANTE de la aplicación
# ---------------------------------------------------------------------------
# El bloqueo por intentos fallidos cuenta también por IP (AXES_LOCKOUT_PARAMETERS
# en settings.py), y para eso axes necesita la IP REAL del cliente. Detrás de un
# balanceador esa IP llega en la cabecera X-Forwarded-For, que es una LISTA: hay
# que decirle cuántas entradas saltar.
#
# Si se deja en 0 habiendo un proxy delante, axes ve la IP del balanceador para
# TODO el mundo y 5 fallos de cualquier empleado bloquean a la plantilla ENTERA.
# El check `core.E003` impide desplegar así (manage.py check --deploy).
#
#   0  desarrollo local, sin nada delante            <- valor por defecto en dev
#   1  Nginx (camino EC2) o ALB (camino Fargate)     <- valor por defecto en producción
#   2  si algún día se añade CloudFront delante del ALB
#
# Este ajuste NO funciona solo: necesita el extra django-axes[ipware] (ya está en
# requirements.txt) y AXES_IPWARE_META_PRECEDENCE_ORDER, que settings.py activa
# automáticamente en cuanto este número es > 0. Sin esas dos piezas el valor se
# ignora EN SILENCIO y axes vuelve a ver la IP del balanceador; de eso avisa el
# check `core.E004`.
#
# VERIFICAR EN STAGING antes de producción:
#   python manage.py verificar_ip_cliente
AXES_IPWARE_PROXY_COUNT=0

# Nota para desarrollo: al contar también la IP, 5 contraseñas falladas seguidas
# bloquean 127.0.0.1 durante una hora, lo que afecta a TODOS los usuarios locales.
# Para desbloquear sin esperar:  python manage.py axes_reset
