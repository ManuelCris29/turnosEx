# Plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales

ENVIRONMENT=development  # development | production

SECRET_KEY=cambia-esto-por-una-clave-segura-generada

DEBUG=True  # False en producción

ALLOWED_HOSTS=127.0.0.1,localhost  # En prod: tu-dominio.com

# Base de datos MySQL
DB_NAME=bdturnosex
DB_USER=root
DB_PASSWORD=tu-contraseña-aqui
DB_HOST=localhost
DB_PORT=3306

# Segundos que se reutiliza una conexión a la base (0 = abrir y cerrar en cada
# petición). Por defecto: 0 en desarrollo, 60 en producción. No suele tocarse.
# DB_CONN_MAX_AGE=60

# TLS hacia la base. Vacío = sin cifrado (desarrollo, base local).
# En producción, ruta al bundle de CA de Amazon que la imagen ya incluye:
#   DB_SSL_CA=/app/certs/rds-ca-global.pem
DB_SSL_CA=

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@dominio.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
DEFAULT_FROM_EMAIL=tu-email@dominio.com

# URL del sitio (sin slash final)
SITE_URL=http://127.0.0.1:8000  # En prod: https://tu-dominio.com

# CORS - dominios que pueden consumir la app (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Caché. Vacío o sin definir = LocMemCache, válido SOLO en desarrollo (1 proceso).
# En producción es OBLIGATORIA una caché compartida: Gunicorn corre varios workers
# y con LocMemCache cada uno tendría la suya, así que invalidar Mis Turnos limpiaría
# solo uno y los demás servirían datos viejos hasta una hora.
#   redis://mi-cluster.cache.amazonaws.com:6379/1   (ElastiCache; rediss:// si usa TLS)
#   db://cache_appturnos                            (tabla en RDS; requiere una vez:
#                                                    python manage.py createcachetable)
CACHE_URL=
