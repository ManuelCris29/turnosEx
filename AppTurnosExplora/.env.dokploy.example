# =============================================================================
# Variables de entorno para el despliegue en Dokploy
# =============================================================================
# Se pegan en la Application → pestaña ENVIRONMENT. No se crea ningún fichero
# `.env` en el servidor: `config/settings.py` llama a `read_env()` sobre un
# fichero que no existe dentro de la imagen (está en `.dockerignore`) y lee de
# `os.environ`, que es lo que Dokploy inyecta.
#
# Paso a paso completo:
#   docs/05-referencia/deployment/CHECKLIST_DESPLIEGUE_DOKPLOY.md
#
# NO PEGAR ESTE BLOQUE ENTERO DE UNA VEZ. Se hace en dos tandas:
#   FASE 5 — arranque de humo, con los valores marcados [HUMO]
#   FASE 7 — valores definitivos, con los marcados [FINAL], tras el certificado
# El motivo está en el bloque de HTTPS, más abajo. No es un capricho de orden.
# =============================================================================

ENVIRONMENT=production
DEBUG=False

# -----------------------------------------------------------------------------
# SECRET_KEY
# -----------------------------------------------------------------------------
# Genérala con:
#   python -c "import secrets; print(secrets.token_hex(50))"
#
# Se usa `token_hex` y no `get_random_secret_key()` de Django a propósito: la de
# Django puede incluir `$`, `%` y `(`. Aquí no interpola nada (Dokploy usa
# `${{project.X}}`, con llaves dobles), pero el mismo valor acaba pegado en
# ficheros compose y en shells donde `$` sí muerde. Hexadecimal no da problemas
# en ningún sitio y no se pierde nada.
#
# ⚠️ FIRMA LOS ENLACES DE APROBACIÓN DE LOS CORREOS. Rotarla invalida todos los
# enlaces ya enviados (viven hasta APPROVAL_LINK_MAX_AGE_DAYS). No se cambia por
# rutina.
SECRET_KEY=

# -----------------------------------------------------------------------------
# Dominio — OJO A LOS FORMATOS, es el error más repetido
# -----------------------------------------------------------------------------
# ALLOWED_HOSTS va SIN esquema. Los otros tres CON esquema. SITE_URL además SIN
# barra final. Si ALLOWED_HOSTS lleva `https://`, Django responde 400 a todo el
# mundo y el mensaje no dice por qué.
#
# [HUMO]  el dominio *.traefik.me que Dokploy asigna solo:
#   ALLOWED_HOSTS=swalp-web-abc123-10-0-0-5.traefik.me
#   CSRF_TRUSTED_ORIGINS=http://swalp-web-abc123-10-0-0-5.traefik.me
#   CORS_ALLOWED_ORIGINS=http://swalp-web-abc123-10-0-0-5.traefik.me
#   SITE_URL=http://swalp-web-abc123-10-0-0-5.traefik.me
#
# [FINAL]
ALLOWED_HOSTS=swalp.parqueexplora.org
CSRF_TRUSTED_ORIGINS=https://swalp.parqueexplora.org
CORS_ALLOWED_ORIGINS=https://swalp.parqueexplora.org
SITE_URL=https://swalp.parqueexplora.org

# -----------------------------------------------------------------------------
# HTTPS — y por qué esto va en dos tandas
# -----------------------------------------------------------------------------
# [HUMO]  SECURE_HTTPS=False
# [FINAL] SECURE_HTTPS=True   ← solo DESPUÉS de que Let's Encrypt emita el certificado
#
# Con SECURE_HTTPS=True, `settings.py` activa HSTS con UN AÑO, includeSubDomains
# y preload. En cuanto un navegador ve esa cabecera, ese host queda comprometido
# a HTTPS durante un año PARA ESA PERSONA, y no hay forma de apagarlo desde el
# servidor: no es una configuración, es una promesa que el navegador recuerda.
#
# Por eso la prueba de humo va sobre el dominio temporal de Dokploy: si algo sale
# mal, se quema un nombre desechable y no el dominio real.
SECURE_HTTPS=True

# -----------------------------------------------------------------------------
# django-axes: cuántos proxies hay DELANTE
# -----------------------------------------------------------------------------
# EL AJUSTE MÁS PELIGROSO DE TODO EL DESPLIEGUE.
#
# axes bloquea también por IP. Detrás de un proxy, la IP real llega en
# X-Forwarded-For, que es una LISTA: hay que decirle cuántas entradas saltar.
# Si el número es menor que los proxies reales, axes ve la IP del proxy para
# TODO el mundo y 5 contraseñas falladas de cualquiera BLOQUEAN A LOS 300
# EMPLEADOS.
#
#   1  solo Traefik (lo normal en Dokploy)      ← empieza por aquí
#   2  si IT tiene otro proxy corporativo delante
#
# NO SE ADIVINA, SE MIDE, y antes de dar la URL a nadie:
#   python manage.py verificar_ip_cliente
# Debe imprimir la IP pública de quien navega, no una 10.x/172.x del proxy.
AXES_IPWARE_PROXY_COUNT=1

# -----------------------------------------------------------------------------
# Base de datos — servicio MySQL de Dokploy
# -----------------------------------------------------------------------------
# DB_HOST sale de la pestaña "Internal Credentials" del servicio MySQL. Es el
# nombre interno de la red overlay, NO una IP y NO localhost.
DB_NAME=bdturnosex
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# TLS hacia la base: SE DEJA VACÍO, y es lo correcto.
# La app y MySQL hablan por la red overlay dentro del mismo servidor; no hay
# tráfico saliendo a internet que cifrar. `manage.py check --deploy` avisará con
# `core.W002`: es esperado, no es un pendiente.
#
# ⚠️ NO lo apuntes a /app/certs/rds-ca-global.pem. Ese fichero sigue en la imagen
# porque el Dockerfile lo trae de los tiempos de RDS, pero aquí no hay ningún RDS
# y la verificación de identidad fallaría.
DB_SSL_CA=

# -----------------------------------------------------------------------------
# Caché — Redis, OBLIGATORIA en producción
# -----------------------------------------------------------------------------
# Gunicorn corre con 3 workers. Con LocMemCache cada uno tendría la suya, así que
# invalidar "Mis Turnos" al aprobar una solicitud limpiaría solo el worker que
# atendió esa petición: el explorador vería su turno corregido o sin corregir
# según a qué worker cayera, y cambiaría al refrescar. `core.E001` bloquea el
# despliegue si esto queda vacío, y el CI lo comprueba.
#
# El servicio Redis de Dokploy trae contraseña: va en la URL.
#   redis://:LA-CONTRASEÑA@nombre-interno:6379/1
#
# (En AWS se había elegido `db://cache_appturnos` por los ~$12/mes de
# ElastiCache. Autohospedado, Redis cuesta 0 y evita el `createcachetable`.)
CACHE_URL=

# -----------------------------------------------------------------------------
# Correo — Google Workspace
# -----------------------------------------------------------------------------
# Ver docs/05-referencia/deployment/MANUAL_CORREO_GOOGLE_WORKSPACE.md
#
# OPCIÓN RECOMENDADA: relay SMTP autenticado POR IP. Sin credenciales — es la
# única forma de que un cambio de contraseña no vuelva a tumbar el envío.
EMAIL_HOST=smtp-relay.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ⚠️ ESTAS DOS TIENEN QUE EXISTIR AUNQUE VAYAN VACÍAS.
# `config/settings.py` las lee sin `default`: si faltan, la aplicación NO ARRANCA
# (ImproperlyConfigured). Vacías sí funciona: el backend SMTP de Django solo
# llama a `login()` si hay usuario Y contraseña.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Con espacios y con `<>`: van entre comillas dobles.
DEFAULT_FROM_EMAIL="SWALP <no-reply@parqueexplora.org>"

# ⚠️ EMAIL_BACKEND SE DEJA SIN DEFINIR. Si alguien lo pone en `console`, los
# correos se escriben en el log, no los recibe nadie, y NO HAY NINGÚN ERROR.

EMAIL_SEND_ASYNC=True
EMAIL_TIMEOUT=10

# -----------------------------------------------------------------------------
# Enlaces de los correos
# -----------------------------------------------------------------------------
# 30 minutos para el enlace de recuperación (Django trae 3 días por defecto; ese
# enlace es una llave de la cuenta viajando por correo).
PASSWORD_RESET_TIMEOUT=1800
# Días que siguen sirviendo los enlaces de aprobar/rechazar del correo. Actúan
# SIN iniciar sesión, van firmados con SECRET_KEY, y por eso caducan.
APPROVAL_LINK_MAX_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Alarmas de las tareas programadas
# -----------------------------------------------------------------------------
# Destinatarios de `manage.py alertar_crons`, separados por coma.
# Dokploy NO notifica cuando un Schedule falla: sus disparadores son despliegues,
# backups, limpieza de Docker y umbrales del servidor. Sin esta variable, un cron
# caído no se lo dice a nadie.
ALERTAS_CRON_EMAIL=

# -----------------------------------------------------------------------------
# Gunicorn
# -----------------------------------------------------------------------------
# No se calcula con `nproc`: dentro de un contenedor devuelve los núcleos del
# ANFITRIÓN, no los que el servicio tiene asignados.
#   0,5 vCPU -> 2      1 vCPU -> 3      2 vCPU -> 5
GUNICORN_WORKERS=3
